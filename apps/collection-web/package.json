{
  "name": "barrelbook-collection-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 4180",
    "build": "next build",
    "start": "next start --port 4180",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests scripts next.config.ts",
    "test": "vitest run --exclude tests/emulator.test.ts",
    "test:emulator": "vitest run tests/emulator.test.ts",
    "test:all": "vitest run",
    "dev:emulator": "node scripts/dev-emulator.mjs",
    "dev:staging": "node --env-file=.env.staging.local scripts/local-staging.mjs dev",
    "build:staging": "node --env-file=.env.staging.local scripts/local-staging.mjs build",
    "start:staging": "node --env-file=.env.staging.local scripts/local-staging.mjs start"
  },
  "dependencies": {
    "@vercel/oidc": "4.0.8",
    "firebase": "13.1.0",
    "firebase-admin": "13.10.0",
    "google-auth-library": "10.9.1",
    "lucide-react": "0.542.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@types/node": "^24",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.12.0 <25"
  }
}
